# Personal runtime data: save backups, logs, crash reports, Steam config backups
/Backups/
/Logs/
/Reports/
/State/
/CrashDumps/

# Built from src\ by Install.cmd / build.cmd
*.exe
*.pdb
*.khhotfix-tmp

# Personal settings that override KHHotfix.ini (may contain private Discord webhook URLs)
KHHotfix.local.ini

# Files prepared for sharing privately (e.g. a KHHotfix.local.ini with Discord webhooks)
/Share/
